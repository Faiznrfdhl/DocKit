# ==========================================
# DocKit .gitignore
# ==========================================

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables (PENTING: Jangan commit secrets!)
.env
.env.local
.env.*.local

# Jinja2 / Template Caches
.jinja2.cache/

# Generated Outputs (Jangan commit hasil zip generate)
*.zip
*.tar.gz
generated_projects/

# Node.js / Next.js (Untuk frontend web nanti)
node_modules/
.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage.xml
*.cover
htmlcov/

# Docker (Optional: kalo ada local docker volumes yang kebawa)
*.log